# ---------------------------------------------------------------
# Database / Payload CMS (news publishing at /admin)
# Dev DB: `npm run db:up` (docker-compose.yml, Postgres 17 on host port 5440)
# ---------------------------------------------------------------
DATABASE_URI=postgres://dev:dev@127.0.0.1:5440/blackhole
# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public base URL of the site, no trailing slash. Used for canonical, hreflang,
# OpenGraph, sitemap, RSS, JSON-LD and Payload live preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extra origins allowed to use the admin session cookie (CSRF allowlist),
# comma-separated, no trailing slash. The site origin above is always allowed.
# Add the admin origin here when /admin is served from another host/port
# (e.g. QA on http://localhost:3100).
PAYLOAD_CSRF_ORIGINS=

# Secret for POST /api/revalidate (cache purge from scheduled publish jobs).
# Empty = derived from PAYLOAD_SECRET (fine for a single server).
REVALIDATE_SECRET=
# Origin the server can reach itself on for that call. Empty = auto
# (http://localhost:$PORT set by `next start`).
REVALIDATE_ORIGIN=

# Scheduled publish runs in-process every minute. On serverless / several
# instances set PAYLOAD_DISABLE_AUTORUN=true and let a cron call
#   GET /api/payload-jobs/run?queue=default   (Authorization: Bearer $CRON_SECRET)
PAYLOAD_DISABLE_AUTORUN=
CRON_SECRET=

# ---------------------------------------------------------------
# Contact form - Cloudflare Turnstile (optional)
# Leave both empty to disable the captcha (honeypot + validation still apply).
# Cloudflare always-pass TEST keys: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA
# ---------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Rate-limit IP source. Header set by a trusted edge (e.g. cf-connecting-ip,
# or x-real-ip from your own nginx); empty = X-Forwarded-For counted from the
# right with TRUSTED_PROXY_HOPS proxies in front of Next (default 1).
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------
# Tracking (all optional; empty = not loaded). Preferred: GTM only,
# with GA4 + Facebook Pixel configured inside the GTM container.
# ---------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# ---------------------------------------------------------------
# Trang ID (account portal). Empty = header buttons link to '#'.
# ---------------------------------------------------------------
NEXT_PUBLIC_ID_LOGIN_URL=
NEXT_PUBLIC_ID_TOPUP_URL=

# ---------------------------------------------------------------
# Seed (`npm run seed`) - first admin account for /admin (dev only)
# ---------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@blackholegame.local
SEED_ADMIN_PASSWORD=change-me
