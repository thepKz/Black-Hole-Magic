# ===============================================================
# Environment variables. Copy to .env for local dev.
# Production (Vercel): set them in Project -> Settings -> Environment Variables,
# step by step in docs/DEPLOY-ADMIN.md. Mark secrets as "Sensitive".
# Never commit real values.
# ===============================================================

# ---------------------------------------------------------------
# Database / Payload CMS (news publishing at /admin)
# Dev DB: `npm run db:up` (docker-compose.yml, Postgres 17 on host port 5440).
# Local dev syncs the schema automatically (drizzle push, localhost DB only).
# Production: schema ONLY from src/cms/migrations (`npm run migrate`, run by
# `npm run vercel-build` on Vercel). Every schema change => `npm run migrate:create <name>`.
# ---------------------------------------------------------------
DATABASE_URI=postgres://dev:dev@127.0.0.1:5440/blackhole
# Vercel/Neon: DATABASE_URI = POOLED url (host contains "-pooler", ?sslmode=require),
# DATABASE_URI_UNPOOLED = direct url, used only to run migrations during the build.
DATABASE_URI_UNPOOLED=
# Connections per server instance (default 3 on Vercel, 10 elsewhere) and connect timeout.
DB_POOL_MAX=
DB_CONNECT_TIMEOUT_MS=
# Force drizzle push on/off (default: on only for a localhost DB outside production).
PAYLOAD_DB_PUSH=
# Long random string, 32+ chars (`node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# Changing it logs everyone out (and changes the derived REVALIDATE_SECRET / contact IP salt
# unless those are set explicitly below).
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public base URL of the site, no trailing slash. Used for canonical, hreflang,
# OpenGraph, sitemap, RSS, JSON-LD, Payload live preview and the admin CSRF list.
# Inlined at BUILD time (redeploy after changing). Production: https://blackholegame.vn
# On Vercel, when empty, falls back to the production domain / preview URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true on staging / preview deployments: robots.txt disallows everything.
NEXT_PUBLIC_NOINDEX=

# Extra origins allowed to use the admin session cookie (CSRF allowlist),
# comma-separated, no trailing slash. Always allowed: the site origin above,
# its www/apex twin and (on Vercel) the deployment's own URLs.
# Add the admin origin here when /admin is served from another host/port
# (e.g. QA on http://localhost:3100).
PAYLOAD_CSRF_ORIGINS=

# First admin: refused from the browser (/admin/create-first-user) on purpose.
# Create it with `npm run bootstrap:admin` from a trusted machine (docs/DEPLOY-ADMIN.md).
# These two are read by that script only - never set them on Vercel.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Temporary escape hatch: allow /admin/create-first-user while the users table is empty.
ALLOW_FIRST_REGISTER=

# ---------------------------------------------------------------
# Outgoing email (optional): "Quên mật khẩu" for editors. Empty SMTP_HOST =
# no mail is sent (admins reset passwords by hand in Hệ thống -> Người dùng).
# Port 465 = implicit TLS, 587 = STARTTLS.
# ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@blackholegame.vn
EMAIL_FROM_NAME=Black Hole Admin

# ---------------------------------------------------------------
# Media storage
# Empty = local disk (folder media/, dev / self-hosting).
# Vercel: connect a Blob store to the project -> Vercel adds BLOB_READ_WRITE_TOKEN.
# Images + videos then go browser -> Blob directly (no 4.5 MB function limit).
# ---------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
# Extra image origins next/image may optimise (comma-separated https://host[/path]),
# e.g. an external CMS's asset CDN.
CONTENT_MEDIA_ORIGINS=

# ---------------------------------------------------------------
# Cache revalidation
# ---------------------------------------------------------------
# Secret for POST /api/revalidate (cache purge from scheduled publish jobs /
# an external CMS webhook). Empty = derived from PAYLOAD_SECRET (single server).
# Set it explicitly in production.
REVALIDATE_SECRET=
# Origin the server can reach itself on for that call. Empty = auto
# (http://localhost:$PORT set by `next start`).
REVALIDATE_ORIGIN=

# ---------------------------------------------------------------
# Scheduled publish / unpublish (Payload jobs)
# Long-lived server: runs in-process every minute.
# Vercel: in-process cron is OFF automatically; vercel.json's cron calls
#   GET /api/payload-jobs/run?queue=default   (Authorization: Bearer $CRON_SECRET)
# every minute (needs the Pro plan; Hobby: use an external cron, see the docs).
# ---------------------------------------------------------------
PAYLOAD_DISABLE_AUTORUN=
CRON_SECRET=

# Optional token for detailed GET /api/health (CRON_SECRET also works).
HEALTH_TOKEN=

# ---------------------------------------------------------------
# Contact form - Cloudflare Turnstile (optional)
# Leave both empty to disable the captcha (honeypot + validation still apply).
# Cloudflare always-pass TEST keys: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA
# ---------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Rate-limit IP source. Header set by a trusted edge (e.g. cf-connecting-ip,
# or x-real-ip on Vercel / your own nginx); empty = X-Forwarded-For counted from the
# right with TRUSTED_PROXY_HOPS proxies in front of Next (default 1).
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=1
# Salt for the stored contact IP hash. Empty = derived from PAYLOAD_SECRET.
CONTACT_IP_SALT=

# ---------------------------------------------------------------
# Content source / contact sink - plug another CMS (docs/CONNECT-CMS.md)
# ---------------------------------------------------------------
# payload | http | mock. Empty = payload when DATABASE_URI is set, else an
# empty newsroom (no 500s, no Payload boot).
CONTENT_SOURCE=
# mock only: serve the [Demo] fixtures of src/site/data/news.ts (never in prod).
CONTENT_MOCK_FIXTURES=
# CONTENT_SOURCE=http (field mapping: src/site/lib/content/http/mapping.ts)
CMS_BASE_URL=
CMS_TOKEN=
CMS_PREVIEW_TOKEN=
# Shared secret the CMS puts in /api/draft?path=...&token= (or HMAC sig+exp).
CMS_PREVIEW_SECRET=
CMS_TIMEOUT_MS=6000
CMS_MEDIA_BASE=
# Signs the bh_preview cookie (empty = REVALIDATE_SECRET); session length in s.
PREVIEW_COOKIE_SECRET=
PREVIEW_MAX_AGE_SECONDS=3600
# Contact: payload | http | log. Empty = http when CONTACT_SINK_URL is set,
# payload when DATABASE_URI is set, log in dev, DISABLED (form error) in prod.
CONTACT_SINK=
CONTACT_SINK_URL=
CONTACT_SINK_TOKEN=
# HMAC-SHA256 of the JSON body -> X-Signature: sha256=<hex>
CONTACT_SINK_SECRET=

# ---------------------------------------------------------------
# Tracking (all optional; empty = not loaded). Preferred: GTM only,
# with GA4 + Facebook Pixel configured inside the GTM container.
# ---------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# ---------------------------------------------------------------
# Seed (`npm run seed`, `seed:news`, `seed:demo-post`) - LOCAL DEV ONLY
# (demo admin + sample articles). Production uses `npm run bootstrap:admin`.
# ---------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@blackholegame.local
SEED_ADMIN_PASSWORD=change-me

# Optional: extra https hosts (comma-separated, exact hostnames) the admin "Dán URL"
# upload may fetch server-side, e.g. your game CDN. Only public CDNs.
MEDIA_PASTE_HOSTS=
